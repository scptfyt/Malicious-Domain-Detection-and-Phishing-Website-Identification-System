SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=1

# Vercel cannot use the local MySQL service at 127.0.0.1.
# Use an externally reachable MySQL-compatible database and set DATABASE_URL in Vercel.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/domain_security?charset=utf8mb4

# Local fallback style, still supported by backend/config.py:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=domain_security

